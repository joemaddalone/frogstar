{
  "name": "frogstar",
  "version": "1.10.0",
  "description": "",
  "license": "MIT",
  "author": "Joe Maddalone",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "seed": "tsx ./src/db/seed.ts",
    "seed:test": "export NODE_ENV=development && npm run seed",
    "push:test": "export NODE_ENV=development && npm run drizzle:push",
    "test": "vitest run --no-watch",
    "test:coverage": "vitest run --coverage",
    "testdb:reset": "tsx ./src/db/reset.ts",
    "release": "semantic-release",
    "drizzle:push": "drizzle-kit push",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "init-rebuild": "npm run drizzle:generate && npm run drizzle:migrate && npm run seed",
    "init-build": "npm run drizzle:push && npm run seed"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.6",
    "@libsql/client": "^0.15.15",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "daisyui": "^5.5.14",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.4.19",
    "lucide-react": "^0.562.0",
    "next": "^16.1.1",
    "next-intl": "^4.6.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.3",
    "react-svg-path": "^2.0.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
